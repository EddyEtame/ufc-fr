{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo 'aucune dependance a installer'",
  "buildCommand": "echo 'site pre-genere, aucune construction necessaire'",
  "outputDirectory": ".",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/resultats",
      "destination": "/categorie/resultats/",
      "permanent": true
    },
    {
      "source": "/analyses",
      "destination": "/categorie/analyses/",
      "permanent": true
    },
    {
      "source": "/interviews",
      "destination": "/categorie/interviews/",
      "permanent": true
    },
    {
      "source": "/evenements",
      "destination": "/categorie/evenements/",
      "permanent": true
    },
    {
      "source": "/combattants",
      "destination": "/categorie/combattants/",
      "permanent": true
    },
    {
      "source": "/ufc-paris-2026",
      "destination": "/categorie/ufc-paris-2026/",
      "permanent": true
    },
    {
      "source": "/actualites",
      "destination": "/actualite-du-mma/",
      "permanent": true
    },
    {
      "source": "/clubs",
      "destination": "/clubs-mma-francais/",
      "permanent": true
    },
    {
      "source": "/champions",
      "destination": "/champions-mma-actuels/",
      "permanent": true
    },
    {
      "source": "/forum",
      "destination": "/forum-communaute-mma/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/media/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(css|js)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "/corpus.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}
